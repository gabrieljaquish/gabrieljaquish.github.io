---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { countTags, getPosts } from '../../lib/posts';

const posts = await getPosts();
const tags = countTags(posts);
---

<Base title="Blog" description="Notes on security, boats, old diesels, and software.">
  <h1>Blog</h1>
  <p class="muted">Security, the marina, the workshop, and software. <a href="/rss.xml">RSS</a></p>

  {
    tags.length > 0 && (
      <ul class="tags" aria-label="Browse by tag">
        {tags.map(([tag, count]) => (
          <li>
            <a href={`/blog/tags/${tag}/`}>
              #{tag} ({count})
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {posts.length > 0 ? <PostList posts={posts} /> : <p>No posts yet.</p>}
</Base>
