---
import PostList from '../../../components/PostList.astro';
import Base from '../../../layouts/Base.astro';
import { countTags, getPosts, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return countTags(posts).map(([tag]) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<Base title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <h1>#{tag}</h1>
  <p class="muted"><a href="/blog/tags/">All tags</a> · <a href="/blog/">All posts</a></p>
  <PostList posts={posts} />
</Base>
