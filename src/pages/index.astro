---
import { getCollection, render } from 'astro:content';
import PostList from '../components/PostList.astro';
import { HEADLINE, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const cards = (await getCollection('cards', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const renderedCards = await Promise.all(
  cards.map(async (card) => ({ card, Content: (await render(card)).Content })),
);
const latest = (await getPosts()).slice(0, 3);
---

<Base>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p class="headline">{HEADLINE}</p>
    <p>
      I am a Consultant at Amazon Web Services and co-owner of Bridgeview
      Harbour Marina. I founded and operate the seasonal Port Henry Waterfront Farmers' Market, and 
      am VP of the Moriah Chamber Of Commerce.  I love helping small businesses and the communities around them thrive.
    </p>
  </section>

  <h2 class="section-title">What I spend my time on</h2>
  <div class="cards">
    {
      renderedCards.map(({ card, Content }) => (
        <article class="card">
          <h3>{card.data.title}</h3>
          <p class="tagline">{card.data.tagline}</p>
          {card.body?.trim() && (
            <div class="body">
              <Content />
            </div>
          )}
          {card.data.links.length > 0 && (
            <ul class="card-links">
              {card.data.links.map((link) => (
                <li>
                  <a href={link.href} rel={link.href.startsWith('http') ? 'noopener' : undefined}>
                    {link.label} →
                  </a>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>

  {
    latest.length > 0 && (
      <>
        <h2 class="section-title">Latest from the blog</h2>
        <PostList posts={latest} />
        <p>
          <a href="/blog/">All posts →</a>
        </p>
      </>
    )
  }
</Base>
