---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { getPosts } from '../lib/posts';
import bgPreload from '../scripts/bg/preload.js?raw';

interface Props {
  title?: string;
  description?: string;
  // Set on cross-posted content so search engines credit the original.
  canonicalUrl?: string;
  noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, canonicalUrl, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
// Blog nav and RSS stay hidden until there's at least one published post.
const hasPosts = (await getPosts()).length > 0;
---

<!doctype html>
<html lang="en" data-bg="soundings">
  <head>
    <meta charset="utf-8" />
    <!-- Applies a saved background before first paint; its hash is in the CSP (astro.config.mjs). -->
    <script is:inline set:html={bgPreload} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {hasPosts && <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />}
    <link rel="author" href="/humans.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <!--
      Reading the source? Good instinct.
      There's more here for people who look closely. Start with the console.
    -->
    <canvas id="bg-canvas" class="bg-canvas" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="wrap" aria-label="Main">
        <a class="brand" href="/">{SITE_TITLE}</a>
        <ul>
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
          {
            hasPosts && (
              <li>
                <a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>
                  Blog
                </a>
              </li>
            )
          }
        </ul>
        <label class="bg-picker" hidden>
          <span class="visually-hidden">Background</span>
          <select id="bg-select">
            <option value="soundings">Lake chart</option>
            <option value="drafting">Drafting sheet</option>
            <option value="radio">Radio waterfall</option>
            <option value="grain">Wood grain</option>
            <option value="off">No background</option>
          </select>
        </label>
      </nav>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <ul class="links">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p>© {new Date().getFullYear()} {SITE_TITLE}</p>
        <p class="bg-credit" data-credit-for="soundings">
          Lake chart: depths and aids to navigation from{' '}
          <a href="https://www.charts.noaa.gov/ENCs/ENCs.shtml" rel="noopener">NOAA Office of Coast Survey</a>{' '}
          charts, shoreline from the{' '}
          <a href="https://www.usgs.gov/national-hydrography" rel="noopener">USGS National Hydrography Dataset</a>.
          Contours interpolated. Not for navigation.
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/console-greeting';
      import '../scripts/bg/manager';
    </script>
  </body>
</html>
