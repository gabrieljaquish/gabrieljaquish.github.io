---
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { gates, navItems } from '../lib/gates';
import bgPreload from '../scripts/bg/preload.js?raw';

interface Props {
  title?: string;
  description?: string;
  // Set on cross-posted content so search engines credit the original.
  canonicalUrl?: string;
  noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, canonicalUrl, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
// Nav items, the RSS link and the colophon links appear only for routes that are actually built
// (src/lib/gates.ts).
const { has } = await gates();
const nav = await navItems();
// The home page puts its chart window (open water and the cartouche) above the panel.
const hasHero = Astro.slots.has('hero');
---

<!doctype html>
<html lang="en" data-bg="soundings">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* A noindex page (404, vault) gets no canonical: the two signals contradict each other, and
        the 404 has no URL of its own to point at. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {has.log && <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />}
    <link rel="author" href="/humans.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    {/* Applies a saved background before first paint. It is the first thing in <body>, not in
        <head>, because Astro writes the CSP <meta> after all of the head's own content, and a
        <meta> policy covers only what comes after it. Its hash is added in astro.config.mjs. */}
    <script is:inline set:html={bgPreload} />
    <!--
      Reading the source? Good instinct.
      There's more here for people who look closely. Start with the console.
    -->
    <canvas id="bg-canvas" class="bg-canvas" aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="wrap" aria-label="Main">
        <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>{SITE_TITLE}</a>
        {
          nav.length > 0 && (
            <ul>
              {nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <label class="bg-picker" hidden>
          <span class="visually-hidden">Background</span>
          <select id="bg-select">
            <option value="soundings">Lake chart</option>
            <option value="drafting">Drafting sheet</option>
            <option value="radio">Radio waterfall</option>
            <option value="grain">Wood grain</option>
            <option value="off">No background</option>
          </select>
        </label>
      </nav>
    </header>

    {/* manager.ts measures the content column from <main>, so its box keeps the same width
        whether or not there is a hero; the panel fill sits on .panel inside it. */}
    <main id="main" class:list={['wrap', { home: hasHero }]}>
      <slot name="hero" />
      <div class="panel"><slot /></div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <ul class="links">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            has.colophon && (
              <li>
                <a href="/colophon/" aria-current={path.startsWith('/colophon/') ? 'page' : undefined}>Colophon</a>
              </li>
            )
          }
        </ul>
        <p>© {new Date().getFullYear()} {SITE_TITLE}</p>
        <p class="bg-credit" data-credit-for="soundings">
          Lake chart: depths and aids to navigation from{' '}
          <a href="https://www.charts.noaa.gov/ENCs/ENCs.shtml" rel="noopener">NOAA Office of Coast Survey</a>{' '}
          charts, shoreline from the{' '}
          <a href="https://www.usgs.gov/national-hydrography" rel="noopener">USGS National Hydrography Dataset</a>.
          Contours interpolated. Not for navigation{has.noteA ? <>; see <a href="/colophon/#note-a">Note A</a>.</> : '.'}
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/console-greeting';
      import '../scripts/bg/manager';
    </script>
  </body>
</html>
